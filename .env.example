# Interlock local configuration. Copy to ignored `.env` and fill blanks.
# Never put secret values in this file. Processes load `.env` as KEY=VALUE
# data, not as shell.

# ── OpenAI (bounded interpretation only) ──
MODEL_PROVIDER=openai
OPENAI_API_KEY=
MODEL=gpt-5.4-mini-2026-03-17

# ── CopilotKit Intelligence / Slack channel ──
# Project-scoped Intelligence key (`cpk-{projectId}_...`) and Channel Code.
INTELLIGENCE_API_KEY=
CHANNEL_CODE=
LOG_LEVEL=warn
PORT=3000
# Override both or neither for non-production Intelligence hosts.
# INTELLIGENCE_API_URL=
# INTELLIGENCE_GATEWAY_WS_URL=
# App-level token (`xapp-…`) for Slack Socket Mode. Required for unmentioned
# ambient pickup; the managed CopilotKit adapter only forwards mentions.
# Generate at api.slack.com → your app → Basic Information → App-Level Tokens
# with connections:write, then enable Socket Mode and subscribe message.channels.
INTERLOCK_SLACK_APP_TOKEN=

# ── Coordinator (loopback SQLite owner) ──
INTERLOCK_DB_PATH=.interlock/interlock.db
INTERLOCK_COORDINATOR_URL=http://127.0.0.1:4317
INTERLOCK_COORDINATOR_PORT=4317
INTERLOCK_COORDINATOR_TOKEN=

# ── Slack identities (platform IDs, not display names) ──
INTERLOCK_SLACK_WORKSPACE_ID=
INTERLOCK_SLACK_CHANNEL_ID=
INTERLOCK_OWNER_ID=

# ── Allowlisted target ──
INTERLOCK_RESOURCE_ID=checkout
INTERLOCK_TARGET_REVISION=
INTERLOCK_TARGET_URL=
INTERLOCK_TARGET_SERVICE=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
# Dedicated execution identity; when blank, token acquisition visibly warns
# that authorized-user ADC is the local compatibility fallback.
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=
# Bot token posts the Socket Mode approval card and attaches the managed
# Channel. Signing secret is managed-Channel-only.
INTELLIGENCE_CHANNEL_INTERLOCK_SLACK_BOT_TOKEN=
INTELLIGENCE_CHANNEL_INTERLOCK_SLACK_SIGNING_SECRET=
# Must equal the target service's own FAULT_TOKEN. The walkthrough uses it to
# degrade the rehearsal target on purpose; the deployed service closes the
# fault path entirely when its side is unset, so an anonymous caller cannot
# degrade it.
CHECKOUT_FAULT_TOKEN=
